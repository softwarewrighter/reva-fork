| vim: ft=reva :
|
| helper -- `help` and `help/` for reva-fork (docs/README.md)
|
| reva.f loads this library the first time `help` or `help/` is used.  The
| original read a SQLite database (help.db); reva-fork builds a text index
| of the same documentation (src/help.txt and the def: entries in lib/)
| when it is built, and embeds it as /reva/lib/help.idx, so help works in
| every host, the browser included.  A record per word: char 1, the name,
| a newline, the text to show.

push~
~

0 value help-text   0 value help-len

| The index, read once.
: help-load ( -- )
  help-len if ;then
  libdir pad place " help.idx" pad +place
  pad count slurp to help-len to help-text ;

| The record key of a name: char 1, the name, a newline.
create help-key 260 allot
: help>key ( a n -- a2 n2 )
  255 min >r  1 help-key c!  help-key 1+ r@ move
  10 help-key r@ + 1+ c!  help-key r> 2 + ;

| The text shown for word a n, if it is documented.
: help-entry ( a n -- a2 n2 true | false )
  help-load  dup 2 + >r  help>key help-text help-len 2swap search
  if r> /string 1 split if 2nip then true else r> drop false then ;

| Call xt ( a n -- ) with the name of every documented word.
: help-each ( xt -- )
  >r help-load help-len 0if r> drop ;then
  help-text help-len 1 /string
  repeat
    1 split 0if 0 0 2swap then
    10 split if 2nip then  r@ execute
  dup 0 > while 2drop r> drop ;

: help-usage ( -- )
  ." help WORD    the documentation of WORD (help dup, help notebook)" cr
  ." help/ TEXT   the documented words whose names contain TEXT" cr ;

| help WORD
: (help) ( a n -- )
  dup 0if 2drop help-usage ;then
  help-load help-len 0if 2drop ." help: no help index here" cr ;then
  2dup help-entry if type 2drop ;then
  ." no help for " type cr ;

| help/ TEXT: the names that contain it.
create help-sought 256 allot
: help-match ( a n -- )  2dup help-sought count search if 2drop type space else 2drop then ;
: (help/) ( a n -- )
  dup 0if 2drop help-usage ;then
  help-sought place  ['] help-match help-each cr ;

:: parsews (help) ; is help
:: parsews (help/) ; is help/

pop~

|||

def: help
ctx: ~
stack: <name> --
desc: =
	Shows the documentation of the word <name>: its stack picture,
	context, source and description.  "help" alone shows how to use it.
=

def: help/
ctx: ~
stack: <text> --
desc: =
	Lists the documented words whose names contain <text>.
=

def: help-each
ctx: ~
stack: xt --
desc: =
	Calls xt ( a n -- ) with the name of every documented word.
=

def: help-entry
ctx: ~
stack: a n -- a2 n2 true | false
desc: =
	The documentation of the word a n, as "help" shows it, if there is
	any.
=
