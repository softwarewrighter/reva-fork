| vim: ft=reva :
| SQLite interface (http://sqlite.org/)
|
| On the portable core this reaches SQLite through the virtual library
| reva-sqlite (docs/design.md 3.11): handles are small integers and
| strings are ( a n ), so there are no C pointers or callbacks here.  The
| words below, and the ~db words they plug into, are the same as before.
| SQLite is served on the CLI and in the desktop app.

push~
needs db/common

~strings ~util ~db

context: ~sqlite
~sqlite

" reva-sqlite" lib rsql

| the functions: a string is two cells ( a n ); a function that answers
| with bytes returns their length, and rsql_ptr gives their address
0 func: rsql_rc
0 func: rsql_ptr
0 func: rsql_version
2 func: rsql_open
1 func: rsql_close
3 func: rsql_exec
1 func: rsql_lastid
1 func: rsql_errmsg
3 func: rsql_query
1 func: rsql_next
2 func: rsql_getcol
1 func: rsql_endquery
3 func: rsql_prepare
2 func: rsql_bind_null
3 func: rsql_bind_int
4 func: rsql_bind_text
4 func: rsql_bind_blob
3 func: rsql_bind_zeroblob
1 func: rsql_reset
1 func: rsql_clear
1 func: rsql_step
1 func: rsql_finalize
2 func: rsql_column_int
2 func: rsql_column_text
2 func: rsql_column_blob

| a bytes answer: its length is on the stack, the bytes at rsql_ptr
: (bytes) ( n -- a n ) rsql_ptr swap ;

0 constant SQLITE_CONSTANT
-1 constant SQLITE_TRANSIENT

: sqlite_finalize ( stmt -- ) rsql_finalize sql_result ! ;
: sqlite_unbind ( stmt -- ) dup rsql_reset drop rsql_clear sql_result ! ;
: sqlite_errmsg ( db -- a n ) rsql_errmsg (bytes) ;
| open a database and return the handle (0 if it could not be opened)
: sqlite_open ( addr len -- handle ) rsql_open rsql_rc sql_result ! ;
: sqlite_close ( handle -- ) rsql_close sql_result ! ;
: sqlite_exec ( handle addr len -- ) rsql_exec sql_result ! ;
: sqlite_version ( -- a n ) rsql_version (bytes) ;
: sqlite_lastid ( handle -- n ) rsql_lastid ;

| convenience functions:
| sql_fetch$ ( handle a n -- a1 n1 )
| sql_fetch# ( handle a n -- n )
| sql_fetch ( handle xt a n -- n )
| sql_getcol$ ( n -- a n )
| sql_getcol# ( n -- n )

| Pass the 'xt' to call for each row.  This callback is a regular Forth word,
| and has the stack-diagram ( n -- flag ).  That is, the number of columns in
| this row, and it passes back the flag 'false' to continue or 'true' to stop

variable sql_mru_query | the query whose row sql_getcol$ reads

: sqlite_getcol$ ( n -- a n ) sql_mru_query @ swap rsql_getcol (bytes) ;
: sqlite_getcol# ( n - n2 ) sqlite_getcol$ >>single ;

| call xt ( ncols -- flag ) for one row and keep only its flag: SQLite
| called the callback on a stack of its own, so callbacks may leave more
| (sql_oneshot leaves ncols)
: (row) ( xt ncols -- flag )
	depth 2 - >r swap execute r> swap >r
	repeat depth 1- over > if nip true else false then while
	drop r> ;

| call xt for each row of query q until it says true; the number of rows
| it was called for
: (fetch-rows) ( xt q -- count )
	0 >r
	repeat
		dup rsql_next dup 0 < if
			drop false
		else
			r> 1+ >r
			>r over r> (row) not
		then
	while
	2drop r> ;

: sqlite_fetch ( handle a n xt -- n )
	>r rsql_query rsql_rc sql_result !
	dup 0if drop r> drop 0 ;then
	sql_mru_query @ swap dup sql_mru_query !  | prior q   R: xt
	r> swap dup >r (fetch-rows)               | prior count   R: q
	r> rsql_endquery drop
	swap sql_mru_query ! ;

: sqlite_prepare ( db a n -- stmt ) rsql_prepare rsql_rc sql_result ! ;

: sqlite_bind_null ( sql position -- )
	rsql_bind_null sql_result ! ;
: sqlite_bind_int ( sql position int -- )
	rsql_bind_int sql_result ! ;
: sqlite_bind_string ( sql position a n -- )
	rsql_bind_text sql_result ! ;
: sqlite_bind_blob ( sql position a n -- )
	rsql_bind_blob sql_result ! ;
: sqlite_bind_blobz ( sql position n -- )
	rsql_bind_zeroblob sql_result ! ;

1 constant SQLITE_ERROR
5 constant SQLITE_BUSY
21 constant SQLITE_MISUSE
101 constant SQLITE_DONE
100 constant SQLITE_ROW

: sqlite_next ( stmt xt -- f )
	sql_result off
	over rsql_step
	dup SQLITE_ROW = if drop execute ;then
	dup SQLITE_DONE = if drop else sql_result ! then
	2drop false ;

: sqlite_first ( stmt -- ) rsql_reset drop ;

: sqlite_pexec ( stmt xt -- )
	over sqlite_first
	repeat 2dup sqlite_next while
	over sql_unbind 2drop
	;

: sqlite_pcol_text ( stmt n -- a n ) rsql_column_text (bytes) ;
: sqlite_pcol_blob ( stmt n -- a n ) rsql_column_blob (bytes) ;
: sqlite_pcol_int ( stmt n -- n ) rsql_column_int ;

~db
: sqlite ( -- )
	['] sqlite_open is sql_open
	['] sqlite_close is sql_close
	['] sqlite_exec is sql_exec
	['] sqlite_version is sql_version
	['] sqlite_lastid is sql_lastid
	['] sqlite_fetch is sql_fetch
	['] sqlite_getcol$ is sql_getcol$
	['] sqlite_getcol# is sql_getcol#
	['] sqlite_prepare is sql_prepare
	['] sqlite_bind_null is sql_bind_null
	['] sqlite_bind_int is sql_bind_int
	['] sqlite_bind_string is sql_bind_string
	['] sqlite_bind_blob is sql_bind_blob
	['] sqlite_bind_blobz is sql_bind_blobz
	['] sqlite_pexec is sql_pexec
	['] sqlite_first is sql_first
	['] sqlite_next is sql_next
	['] sqlite_pcol_text is sql_pcol_text
	['] sqlite_pcol_int is sql_pcol_int
	['] sqlite_pcol_blob is sql_pcol_blob
	['] sqlite_finalize is sql_finalize
	['] sqlite_unbind is sql_unbind
	['] sqlite_errmsg is sql_errmsg
	;

' sqlite ~sys.onstartup
sqlite

pop~
|||
def: sqlite
ctx: ~db
stack:  --
ver: 6.1.8
desc: =
	Sets the deferred database access words to use the SQLite bindings.
	This word is automatically called when the this library is used.
=


