# build output: the root target/ (.cargo/config.toml), and any other a
# build that missed that config makes (components/cli/target/ once did)
target/
/components/web/crates/reva-web/www/reva.wasm
/components/web/crates/reva-web/www/ui/
# the notebook's save file and its backup, when it runs from the root
# (lib/ui/notebook)
/notebook.txt
/notebook.bak
# agentrail session logs: too large and too private for this public
# repository. agentrail keeps them outside it now, and `agentrail shadow
# push` copies them to the private shadow repository; this stays in case
# an older agentrail writes them here again (docs/agentrail-asks.md)
/.agentrail/sessions/
