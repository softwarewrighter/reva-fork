{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reva",
  "identifier": "com.softwarewrighter.reva",
  "version": "0.1.0",
  "build": {
    "frontendDist": "../../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "app", "dmg", "nsis", "msi"],
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"],
    "resources": {
      "../../../../LICENSE": "LICENSE",
      "../../../../LICENSE-MIT": "LICENSE-MIT",
      "../../../../LICENSING.md": "LICENSING.md",
      "../../../../docs/licenses.md": "licenses.md"
    },
    "category": "DeveloperTool",
    "copyright": "Reva: public domain (Ron Aaron). Portable core and desktop app: MIT, Michael A. Wright",
    "linux": {
      "deb": { "depends": ["libwebkit2gtk-4.1-0"] }
    }
  }
}
