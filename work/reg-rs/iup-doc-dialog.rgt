command = "grep -v '^$' tests/forth/iup-doc-dialog.f | grep -c -v -x -F -f docs/iup.md; ${REVA:-target/debug/reva} --ui-script tests/ui/doc-dialog.ui tests/forth/iup-doc-dialog.f < /dev/null"
exit_code = 0
desc = "docs/iup.md's dialog sample: 0 of its lines missing from the page, then it runs with scripted events"
