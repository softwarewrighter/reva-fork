command = '''scripts/in-tempdir.sh sh -c '"$REVA" -e "macro : m .\" [m ran] \" parsews type ; forth" -e ": hi .\" compiled after boot\" cr ;" --save-image app.img < /dev/null && printf "hi\\nm word\\n" | "$REVA" --image app.img''''
exit_code = 0
desc = "strings compiled after boot survive --save-image (a dot-quote, a macro's string)"
