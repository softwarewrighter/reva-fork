command = "{ ${REVA:-target/debug/reva} --show-boot < /dev/null 2>&1 1>&3 | sed-rs -e 's/reva-fork [0-9.]+ portable/reva-fork VERSION portable/' 1>&2; } 3>&1"
timeout = 60
exit_code = 0
desc = "reva.f boots to completion and restarts (progress marks and banner on stderr; the release version masked)"
