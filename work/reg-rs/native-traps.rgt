command = "${REVA:-target/debug/reva} -e 'needs os/shell' -e '\" echo blocked\" shell' -e '1 . cr' -e ': sse [ $0f 1, $58 1, $c1 1, ] ; sse' -e '2 . cr' -e bye < /dev/null; ${REVA:-target/debug/reva} --allow-shell -e 'needs os/shell' -e '\" echo allowed; exit 3\" shell shell_code @ 256 / . cr' -e bye < /dev/null"
timeout = 60
exit_code = 0
desc = "shell is blocked unless --allow-shell; unsupported x86 code names its class; each stops with a pointer to docs/portability.md and the session goes on"
