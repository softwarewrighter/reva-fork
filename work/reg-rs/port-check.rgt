command = """scripts/in-tempdir.sh sh -c 'cp "$ROOT/tests/forth/windows-only.f" . && "$REVA" --port-check --fix out windows-only.f; echo "exit $?"; diff windows-only.f out/windows-only.f; ls out; "$REVA" --port-check --fix . windows-only.f; echo "exit $?"'"""
exit_code = 0
desc = "reva --port-check: Windows-only paths and commands in a sample program, the safe fixes in a copy (comments and non-path backslashes untouched), never over the source"
