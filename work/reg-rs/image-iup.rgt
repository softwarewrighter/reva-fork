command = """scripts/in-tempdir.sh sh -c '"$REVA" -e "needs ui/gui" --save-image gui.img < /dev/null && "$REVA" --image gui.img --ui-script "$ROOT/tests/ui/hello-world.ui" "$ROOT/examples/iup/hello-world.f" < /dev/null'"""
exit_code = 0
desc = "an image with the IUP library loaded runs examples/iup/hello-world.f (as golden iup-hello-world)"
