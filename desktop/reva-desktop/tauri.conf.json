{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reva",
  "identifier": "com.softwarewrighter.reva",
  "version": "0.1.0",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Reva Forth",
        "width": 960,
        "height": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "app", "dmg"],
    "icon": ["icons/icon.png"],
    "category": "DeveloperTool",
    "copyright": "Reva: public domain (Ron Aaron). Portable core and desktop app: MIT, Michael A. Wright",
    "linux": {
      "deb": { "depends": ["libwebkit2gtk-4.1-0"] }
    }
  }
}
